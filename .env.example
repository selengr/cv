NEXT_PUBLIC_API_URL=http://localhost:5000/api
NEXT_PUBLIC_LOCAL_AUTH=true
NEXT_PUBLIC_APP_URL=http://localhost:3000

# OTP: local shows code on screen; kavenegar sends SMS when API key is set
SMS_PROVIDER=local
# KAVENEGAR_API_KEY=
# KAVENEGAR_SENDER=10008663
NEXT_PUBLIC_SHOW_OTP_HINT=true

# Payments: local = in-app sandbox gateway; zarinpal = real/sandbox merchant API
NEXT_PUBLIC_PAYMENT_DRIVER=local
# ZARINPAL_MERCHANT_ID=
# ZARINPAL_SANDBOX=true

# Optional: POST new-order payloads somewhere (Slack/Discord/email worker)
# ORDER_NOTIFY_WEBHOOK=https://example.com/hooks/shopy
